[Unit]
Description=ogladajanime stream redirector (302/proxy do CDN)
After=network-online.target
Wants=network-online.target
StartLimitBurst=0

[Service]
Type=simple
User=media
Group=media
EnvironmentFile=/etc/oa-anime.env
WorkingDirectory=/opt/ogladajanime/client
ExecStart=/usr/bin/python3 /opt/ogladajanime/client/streamd.py --host 0.0.0.0 --port 9099
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
