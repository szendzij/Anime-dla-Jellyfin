# /etc/oa-anime.env — sekrety i ścieżki. Uprawnienia 0600, właściciel root.
OA_LOGIN=twoj_login
OA_PASS=twoje_haslo

# gdzie leży biblioteka Jellyfina (na tym hoście)
OA_ROOT=/media/extDisk/anime

# adres redirectora widziany przez Jellyfin (ten sam host = 127.0.0.1 działa)
OA_BASE_URL=http://127.0.0.1:9099

# Jellyfin — do automatycznego skanu biblioteki
JELLYFIN_URL=http://127.0.0.1:8096
JELLYFIN_API_KEY=
